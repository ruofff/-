<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html>
<html>
<head>
    <title>医院管理系统 - 仪表盘</title>
    <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/styles.css">
</head>
<body>
    <header>
        <h1>医院管理系统</h1>
        <nav>
            <a href="${pageContext.request.contextPath}/doctors">医生管理</a>
            <a href="${pageContext.request.contextPath}/appointments">预约管理</a>
            <a href="${pageContext.request.contextPath}/logout">退出</a>
        </nav>
    </header>

    <div class="container">
        <h2>欢迎，${user.username}！</h2>
        <p>您的角色：${user.role}</p>

        <div class="dashboard-cards">
            <div class="card">
                <h3>医生统计</h3>
                <p>${doctorCount} 名医生</p>
            </div>

            <div class="card">
                <h3>今日预约</h3>
                <p>${todayAppointments} 个预约</p>
            </div>

            <div class="card">
                <h3>科室数量</h3>
                <p>${departmentCount} 个科室</p>
            </div>
        </div>
    </div>

    <footer>
        <p>&copy; 2023 医院管理系统</p>
    </footer>
</body>
</html>